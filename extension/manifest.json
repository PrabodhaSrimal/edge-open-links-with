{
  "manifest_version": 3,
  "name": "Open Links With Brave",
  "version": "1.0",
  "description": "Opens links matching your URL rules in Brave instead of Edge.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["glob.js", "content.js"],
    "all_frames": true,
    "run_at": "document_start"
  }],
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
